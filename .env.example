# ==============================================================================
# arXiv-GPT Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Engine (Groq)
# ------------------------------------------------------------------------------
# Required for paper summarization and query analysis.
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
SUMMARY_MODEL_NAME=openai/gpt-oss-120b
SUMMARY_PROMPT_VERSION=v1.0

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon / SQLite)
# ------------------------------------------------------------------------------
# Production (Render / Neon):
# Standard PostgreSQL URL provided by Neon.tech or Supabase (sslmode=require).
# Example: postgresql://username:password@ep-xyz.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xyz.region.neon.tech/neondb?sslmode=require

# Local Development Fallback:
# If left empty or unset in local development, the app safely defaults to SQLite:
# DATABASE_URL=sqlite:///./data/arxiv_gpt.db

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Required for user registration, login, and scoped search history persistence.
# Generate a secure 32+ character random string (e.g. `openssl rand -hex 32`):
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. CORS & Cloud Deployment (Render)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Required on Render (must not be wildcard '*').
# Example: https://arxiv-gpt.onrender.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-service-name.onrender.com
